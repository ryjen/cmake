prefix=${pcfiledir}/../..
exec_prefix=${prefix}
includedir=${prefix}/@CMAKE_INSTALL_INCLUDEDIR@
libdir=${prefix}/@CMAKE_INSTALL_LIBDIR@

Name: @PKGCONF_NAME@
Description: @PKGCONF_DESCRIPTION@
URL: @PKGCONF_URL@
Version: @PKGCONF_VERSION@
Cflags: -I${includedir}
Libs: -L${libdir} -l@PKGCONF_NAME@
Libs.private:
